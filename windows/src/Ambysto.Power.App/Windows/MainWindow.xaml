<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ambysto.Power.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ambysto Power">

    <Grid Background="{StaticResource PowerBgBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Ambysto Power" FontFamily="{StaticResource PowerSansFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PowerTextPrimaryBrush}" />
                <Border Background="{StaticResource PowerElevatedBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TierBadgeText" Text="FREE" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerAccentBrush}" />
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="TrayStatusText" Text="Mains" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerTextSecondaryBrush}" />
            </Border>

            <Button Grid.Column="2" Content="Glance Popover" Click="OnOpenPopoverClick" />
        </Grid>

        <!-- Navigation Rail -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="1. Battery" Click="OnShowBatteryTabClick" />
            <Button Content="2. Apps" Click="OnShowAppsTabClick" />
            <Button Content="3. Thermal &amp; Sensors" Click="OnShowThermalTabClick" />
            <Button Content="4. Keep-Awake" Click="OnShowKeepAwakeTabClick" />
            <Button Content="Settings" Click="OnShowSettingsTabClick" />
            <Button x:Name="AboutNavButton" Content="About" Click="OnShowAboutTabClick" AutomationProperties.AutomationId="AboutNavButton" />
            <Button x:Name="BuyCoffeeNavButton" Content="☕ Buy me a coffee" Click="OnBuyCoffeeClick" AutomationProperties.AutomationId="BuyCoffeeNavButton" />
        </StackPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Tab 1: Battery -->
                <StackPanel x:Name="BatteryPanel" Spacing="12" Visibility="Visible">
                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="BATTERY HEALTH &amp; STATE" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="BatteryPrimaryHeadline" Text="Checking battery..." FontFamily="{StaticResource PowerMonoFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PowerTextPrimaryBrush}" />
                            <TextBlock x:Name="BatteryDetailsLine" Text="" FontFamily="{StaticResource PowerSansFont}" FontSize="13" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="BatterySinceUnpluggedLine" Text="" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerAccentBrush}" Visibility="Collapsed" />
                            <TextBlock x:Name="BatteryRecordStartedLine" Text="" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="DAILY HEALTH CURVE &amp; 24H SAMPLES" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="BatteryHistorySummaryText" Text="No daily health points recorded yet." FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 2: Power by App -->
                <StackPanel x:Name="AppsPanel" Spacing="12" Visibility="Collapsed">
                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Last 5 min" Click="OnAppWindow5MinClick" />
                                <Button Content="Last hour" Click="OnAppWindow1HourClick" />
                                <Button Content="Since unplugged" Click="OnAppWindowSinceUnpluggedClick" />
                            </StackPanel>
                            <TextBlock x:Name="AppsHeaderNotesText" Text="Column: estimate · GPU not measured · 0 not measured" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="AppsTableText" Text="No app samples yet." FontFamily="{StaticResource PowerMonoFont}" FontSize="13" Foreground="{StaticResource PowerTextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 3: Thermal & Sensors -->
                <StackPanel x:Name="ThermalPanel" Spacing="12" Visibility="Collapsed">
                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="THERMAL STATE &amp; THROTTLING" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="ThermalStateHeadlineText" Text="Nominal" FontFamily="{StaticResource PowerMonoFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PowerTextPrimaryBrush}" />
                            <TextBlock x:Name="ThermalDetailsText" Text="CPU speed limit: not reported · Warning level: not reported" FontFamily="{StaticResource PowerSansFont}" FontSize="13" Foreground="{StaticResource PowerTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SENSOR FAMILIES" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="SensorFamiliesText" Text="no sensors found" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="THROTTLING EPISODES" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="ThermalEpisodesText" Text="No throttling episodes recorded." FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 4: Keep-Awake -->
                <StackPanel x:Name="KeepAwakePanel" Spacing="12" Visibility="Collapsed">
                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ACTIVE KEEP-AWAKE SESSION" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="KeepAwakeHeadlineText" Text="Inactive" FontFamily="{StaticResource PowerMonoFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PowerTextPrimaryBrush}" />
                            <TextBlock x:Name="KeepAwakeLastNoticeText" Text="" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerWarnBrush}" Visibility="Collapsed" />

                            <StackPanel x:Name="CapQuestionBanner" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="12 h cap approaching — keep PC awake for another 12 h?" VerticalAlignment="Center" Foreground="{StaticResource PowerWarnBrush}" />
                                <Button Content="Keep awake" Click="OnCapAnswerYesClick" />
                                <Button Content="Let sleep" Click="OnCapAnswerNoClick" />
                            </StackPanel>

                            <CheckBox x:Name="MainKeepDisplayOnCheck" Content="Keep display awake (prevent monitor sleep)" IsChecked="True" Foreground="{StaticResource PowerTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Until I turn it off" Click="OnManualIndefiniteClick" />
                                <Button Content="30 min" Click="OnManual30MinClick" />
                                <Button Content="1 h" Click="OnManual1HourClick" />
                                <Button Content="2 h" Click="OnManual2HoursClick" />
                                <Button Content="4 h" Click="OnManual4HoursClick" />
                                <Button Content="Stop" Click="OnManualStopClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="AUTOMATIC KEEP-AWAKE RULES (PRO)" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBox x:Name="RuleAppInputBox" PlaceholderText="Application name or executable (e.g., Code.exe)" Text="Code.exe" />
                            <CheckBox x:Name="RuleHelpersCheck" Content="Count helper processes in the same app folder" IsChecked="False" Foreground="{StaticResource PowerTextSecondaryBrush}" />
                            <Button x:Name="SaveRuleButton" Content="Save Rule" Click="OnSaveAppRuleClick" AutomationProperties.AutomationId="SaveRuleButton" />
                            <TextBlock x:Name="RulesPlainEnglishText" AutomationProperties.AutomationId="RulesPlainEnglishText" Text="No rules saved." FontFamily="{StaticResource PowerSansFont}" FontSize="13" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="FirstRuleLoginBanner" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Start Ambysto Power at login so your rule works after reboot?" VerticalAlignment="Center" Foreground="{StaticResource PowerAccentBrush}" />
                                <Button Content="Enable Start at Login" Click="OnEnableLoginFromBannerClick" />
                                <Button Content="Not now" Click="OnDismissLoginBannerClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SLEEP REQUESTS" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="SleepRequestsText" Text="No active sleep assertions." FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 5: Settings -->
                <StackPanel x:Name="SettingsPanel" Spacing="12" Visibility="Collapsed">
                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="HISTORY RETENTION &amp; STARTUP" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="RetentionNoteText" Text="Free keeps 7 days of history." FontFamily="{StaticResource PowerSansFont}" FontSize="13" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Delete history older than 7 days" Click="OnDeleteOldHistoryClick" />
                                <Button x:Name="ToggleLoginItemButton" Content="Turn On Start at Login" Click="OnToggleLoginItemClick" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsActionFeedbackText" Text="" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerAccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 6: About & License -->
                <StackPanel x:Name="AboutPanel" Spacing="12" Visibility="Collapsed" AutomationProperties.AutomationId="AboutView">
                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource PowerElevatedBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                    <Image x:Name="AboutLogoImage"
                                           Width="48"
                                           Height="48"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="AboutLogoImage" />
                                </Border>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Ambysto Power" FontFamily="{StaticResource PowerSansFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PowerTextPrimaryBrush}" AutomationProperties.AutomationId="AboutAppNameText" />
                                    <TextBlock x:Name="AboutVersionText" Text="Version 0.1.1 (Windows 11 x64)" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerAccentBrush}" AutomationProperties.AutomationId="AboutVersionText" />
                                    <TextBlock x:Name="AboutDeveloperText" Text="Developed by Ambysto · Measure first, change safely, always reversible." FontFamily="{StaticResource PowerSansFont}" FontSize="12" Foreground="{StaticResource PowerTextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="AboutDeveloperText" />
                                    <TextBlock x:Name="AboutWebsiteText" Text="Website: https://power.ambysto.com" FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerTextMutedBrush}" AutomationProperties.AutomationId="AboutWebsiteText" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="OpenWebsiteButton" Content="Website (power.ambysto.com)" Click="OnOpenWebsiteClick" AutomationProperties.AutomationId="OpenWebsiteButton" />
                                <Button x:Name="StarOnGitHubButton"
                                        Click="OnStarOnGitHubClick"
                                        AutomationProperties.AutomationId="StarOnGitHubButton"
                                        AutomationProperties.Name="Star us on GitHub">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- GitHub mark (Octicons mark-github, MIT): decorative; the button's name is its text. -->
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Width="16" Height="16" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                                  Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.66 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
                                        </Viewbox>
                                        <TextBlock Text="Star us on GitHub" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CheckForUpdatesButton" Content="Check for Updates" Click="OnCheckUpdatesClick" AutomationProperties.AutomationId="CheckForUpdatesButton" />
                                <Button x:Name="AboutBuyCoffeeButton" Content="☕ Buy me a coffee" Click="OnBuyCoffeeClick" AutomationProperties.AutomationId="AboutBuyCoffeeButton" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateFeedbackText" Text="Updates are checked only when you click Check for Updates." FontFamily="{StaticResource PowerMonoFont}" FontSize="12" Foreground="{StaticResource PowerAccentBrush}" AutomationProperties.AutomationId="UpdateStatusText" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PowerSurfaceBrush}" BorderBrush="{StaticResource PowerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="AMBYSTO POWER PRO LICENSE" FontFamily="{StaticResource PowerMonoFont}" FontSize="11" Foreground="{StaticResource PowerTextMutedBrush}" />
                            <TextBlock x:Name="LicenseStatusText" Text="Ambysto Power Free" FontFamily="{StaticResource PowerSansFont}" FontSize="14" Foreground="{StaticResource PowerTextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBox x:Name="LicenseKeyInputBox" PlaceholderText="Paste your Ambysto license key" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Activate Key" Click="OnActivateLicenseClick" />
                                <Button Content="Deactivate" Click="OnDeactivateLicenseClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
