{
  "cleanUrls": true,
  "redirects": [
    { "source": "/download", "destination": "/download/AmbystoPower.dmg", "permanent": false },
    { "source": "/download/windows", "destination": "https://github.com/ambysto/ambysto-downloads/releases/latest", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/download/(.*)\\.dmg",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-diskimage" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"AmbystoPower.dmg\"" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
